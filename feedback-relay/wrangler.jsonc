{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cc-connect-feedback",
  "main": "src/compat.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GITHUB_REPO": "timmyagentic/cc-connect-next",
    "GITHUB_LABEL": "user-feedback"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Local/dry-run placeholder. Replace with a unique positive integer in
      // the operator's Cloudflare account before any separately authorized deploy.
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
